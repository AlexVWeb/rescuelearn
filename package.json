{
  "name": "rescuelearn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev --turbopack",
    "build": "next build",
    "vercel-build": "bun run db:generate && bunx prisma migrate deploy && next build",
    "deploy": "bash scripts/deploy.sh",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "bash scripts/migrate.sh",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "bun prisma/seed.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "validate": "prisma validate"
  },
  "dependencies": {
