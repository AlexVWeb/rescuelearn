generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  roles         Json      @default("[]")
  password      String?
  
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope        String?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


model Quiz {
  id              Int      @id @default(autoincrement())
  title           String
  timePerQuestion Int      @default(30)
  passingScore    Int      @default(70)
  modeRandom      Boolean  @default(false)

  questions         Question[]
  categoryQuestions CategoryQuestion[]
  levelId           Int?
  level             LevelQuestion? @relation(fields: [levelId], references: [id])
}

model Question {
  id            Int    @id @default(autoincrement())
  text          String @db.Text
  correctAnswer String 
  explanation   String? @db.Text
  
  quizId Int
  quiz   Quiz @relation(fields: [quizId], references: [id])
  
  options QuestionOption[]
}

model QuestionOption {
  id       Int     @id @default(autoincrement())
  text     String
  optionId String? // e.g. "A", "B"
  
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model CategoryQuestion {
  id      Int    @id @default(autoincrement())
  name    String
  quizzes Quiz[]
}

model LevelQuestion {
  id      Int    @id @default(autoincrement())
  name    String
  quizzes Quiz[]
}

model SNVScenario {
  id          Int    @id @default(autoincrement())
  title       String
  level       String
  description String @db.Text
  
  victimes SNVVictim[]
}

model SNVVictim {
  id            Int    @id @default(autoincrement())
  description   String @db.Text
  correctAnswer Int
  explanation   String @db.Text
  
  scenarioId Int
  scenario   SNVScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
}

model LearningCard {
  id        Int    @id @default(autoincrement())
  theme     String
  niveau    String
  info      String @db.Text
  reference String
  
  referencielId Int?
  referenciel   Referenciel? @relation(fields: [referencielId], references: [id])
}

model Referenciel {
  id          Int    @id @default(autoincrement())
  title       String
  pdfUrl      String
  yearEdition Int
  
  learningCards LearningCard[]
}
