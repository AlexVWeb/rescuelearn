model SNVScenario {
  id          Int    @id @default(autoincrement())
  title       String
  level       String
  description String @db.Text
  
  victimes SNVVictim[]
}

model SNVVictim {
  id            Int    @id @default(autoincrement())
  description   String @db.Text
  correctAnswer Int
  explanation   String @db.Text
  
  scenarioId Int
  scenario   SNVScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
}
