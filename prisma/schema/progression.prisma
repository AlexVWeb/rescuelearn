// Représente un arbre de progression pour un niveau de formation spécifique (GQS, PSC, SST, PSE1, PSE2)
model ProgressionTree {
  id            String            @id @default(cuid())
  level         String            @unique // "GQS" | "PSC" | "SST" | "PSE1" | "PSE2"
  description   String?
  nodes         ProgressionNode[]
  referencielId Int?
  referenciel   Referenciel?      @relation(fields: [referencielId], references: [id], onDelete: SetNull)

  // Génération du parcours depuis les sujets, pilotée nœud par nœud par la page admin
  generationStatus    AnalysisStatus @default(NONE)
  generationPlan      Json? // [{ title, topicIds }] issu de planNodesFromTopics
  generationDone      Int            @default(0) // index du prochain nœud du plan
  generationTotal     Int            @default(0)
  generationError     String?
  generationStartedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Représente un bloc d'apprentissage (un nœud/cercle sur le parcours)
model ProgressionNode {
  id          String          @id @default(cuid())
  treeId      String
  tree        ProgressionTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int // Position ordonnée sur le parcours (0, 1, 2...)
  xpReward    Int             @default(100)

  // Liste des exercices composants ce bloc
  exercises ProgressionNodeExercise[]

  playerProgress PlayerProgress[]
  attempts       ProgressionAttempt[]

  topics ReferencielTopic[]

  @@unique([treeId, order])
}

// Représente un exercice individuel à l'intérieur d'un bloc d'apprentissage
model ProgressionNodeExercise {
  id     String                  @id @default(cuid())
  nodeId String
  node   ProgressionNode         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  order  Int // Ordre de passage de l'exercice au sein de la session (0, 1, 2...)
  type   ProgressionExerciseType

  // Contenu Quiz : Association avec une question de la banque de questions (générée ou liée)
  questionId Int?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  // Contenu Flashcard : Association avec une fiche mémo (LearningCard)
  learningCardId Int?
  learningCard   LearningCard? @relation(fields: [learningCardId], references: [id], onDelete: SetNull)

  // Contenu Micro-cours : Contenu directement embarqué dans l'exercice au format Markdown
  courseTitle   String?
  courseContent String? @db.Text // Format Markdown pour faciliter la génération IA

  // Configuration JSON générique pour de futurs mini-jeux (ex: ordonner des gestes)
  gameConfig Json?

  attemptAnswers ProgressionAttemptAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProgressionExerciseType {
  QUIZ_QUESTION
  MICRO_COURSE
  FLASHCARD
  MINI_GAME
}

// Suivi de la complétion du joueur pour chaque bloc
model PlayerProgress {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId      String
  node        ProgressionNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  completedAt DateTime        @default(now())
  score       Int? // Pourcentage de réussite ou score obtenu

  @@unique([userId, nodeId])
}

// Tentative d'un joueur sur un bloc : les réponses sont notées côté serveur,
// le score final en est déduit (le client ne peut pas l'envoyer lui-même).
model ProgressionAttempt {
  id          String                     @id @default(cuid())
  userId      String
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId      String
  node        ProgressionNode            @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  answers     ProgressionAttemptAnswer[]
  startedAt   DateTime                   @default(now())
  completedAt DateTime?

  @@index([userId, nodeId])
}

// Première réponse donnée à une question pendant une tentative (non modifiable)
model ProgressionAttemptAnswer {
  id         String                  @id @default(cuid())
  attemptId  String
  attempt    ProgressionAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   ProgressionNodeExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  isCorrect  Boolean
  answeredAt DateTime                @default(now())

  @@unique([attemptId, exerciseId])
}
