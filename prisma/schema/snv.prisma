model SNVScenario {
  id          Int         @id @default(autoincrement())
  title       String
  level       String
  description String
  victimes    SNVVictim[]
}

model SNVVictim {
  id            Int         @id @default(autoincrement())
  description   String
  correctAnswer Int
  explanation   String
  scenarioId    Int
  scenario      SNVScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
}
