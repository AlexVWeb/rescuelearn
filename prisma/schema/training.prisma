model Organisme {
  id                    String            @id @default(uuid())
  name                  String
  agreementNumber       String?
  logo                  String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  inviteCode            String            @unique @default(cuid())
  address               String?
  city                  String?
  email                 String?
  phone                 String?
  postalCode            String?
  siret                 String?
  website               String?
  retentionYearsActive  Int               @default(5)
  retentionYearsArchive Int               @default(10)
  smtpFrom              String?
  smtpHost              String?
  smtpPassword          String?
  smtpPort              Int?
  smtpSecure            Boolean           @default(true)
  smtpUser              String?
  federationName        String?
  isQualiopi            Boolean           @default(false)
  legalRepFirstName     String?
  legalRepJobTitle      String?
  legalRepLastName      String?
  legalStatus           String?
  qualiopiCertifiedBy   String?
  tvaNumber             String?
  metadata              String?
  slug                  String            @unique
  invitations           Invitation[]
  members               Member[]
  trainees              Trainee[]
  trainingSessions      TrainingSession[]
  users                 User[]
}

model TrainingSession {
  id                       String                     @id @default(uuid())
  type                     String
  title                    String
  location                 String
  status                   String                     @default("planifiée")
  maxTrainees              Int
  formateurId              String
  // Responsable pédagogique (FISE PSE) : membre de l'organisme, formateur ou non
  responsablePedagogiqueId String?
  organismeId              String
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  endDate                  DateTime?                  @db.Date
  isFC                     Boolean                    @default(false)
  startDate                DateTime?                  @db.Date
  inscriptions             Inscription[]
  slots                    Slot[]
  formateur                User                       @relation("SessionOwner", fields: [formateurId], references: [id])
  responsablePedagogique   User?                      @relation("SessionResponsablePedagogique", fields: [responsablePedagogiqueId], references: [id], onDelete: SetNull)
  organisme                Organisme                  @relation(fields: [organismeId], references: [id])
  quizSessions             QuizSession[]
  formateurs               TrainingSessionFormateur[]
  groups                   TrainingGroup[]
  // Publication explicite des attestations dans l'espace stagiaire
  attestationsPublishedAt  DateTime?
  documents                SessionDocument[]

  @@index([responsablePedagogiqueId])
}

model TrainingSessionFormateur {
  id                String          @id @default(cuid())
  trainingSessionId String
  userId            String
  createdAt         DateTime        @default(now())
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingSessionId, userId])
  @@index([userId])
}

model TrainingGroup {
  id                String          @id @default(cuid())
  trainingSessionId String
  name              String
  position          Int
  formateurId       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  formateur         User?           @relation(fields: [formateurId], references: [id], onDelete: SetNull)
  inscriptions      Inscription[]

  @@index([trainingSessionId])
  @@index([formateurId])
}

model Slot {
  id                String          @id @default(cuid())
  label             String
  date              DateTime        @db.Date
  startTime         String
  endTime           String
  trainingSessionId String
  emargements       Emargement[]
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
}

model Trainee {
  id                 String             @id @default(cuid())
  firstName          String?
  lastName           String?
  email              String?
  phone              String?
  dateOfBirth        String?
  organismeId        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  address            String?
  civility           String?
  birthPlace         String?
  emailHash          String?
  ageAtFormation     Int?
  department         String?
  isAnonymized       Boolean            @default(false)
  lastActivityAt     DateTime           @default(now())
  externalTrainings  ExternalTraining[]
  inscriptions       Inscription[]
  organisme          Organisme          @relation(fields: [organismeId], references: [id], onDelete: Cascade)
  quizParticipations QuizParticipant[]

  @@unique([emailHash, organismeId])
}

model ExternalTraining {
  id                String   @id @default(cuid())
  traineeId         String
  organismeId       String
  type              String
  name              String
  organisme         String
  obtainedAt        DateTime @db.Date
  isFC              Boolean  @default(false)
  certificateNumber String?
  fileUrl           String?
  fileKey           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  trainee           Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)
}

model Inscription {
  id                     String          @id @default(cuid())
  status                 String          @default("inscrit")
  traineeId              String
  trainingSessionId      String
  attestationResult      String?
  attestationValidatedAt DateTime?
  emargements            Emargement[]
  trainee                Trainee         @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  trainingSession        TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  groupId                String?
  group                  TrainingGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Espace stagiaire : SHA-256 du token du lien, jamais le token en clair
  accessTokenHash        String?         @unique
  accessSentAt           DateTime?
  accessLastUsedAt       DateTime?
  // Verrou anti-devinette du PIN depuis l'espace stagiaire
  pinFailedCount         Int             @default(0)
  pinLockedUntil         DateTime?

  @@unique([traineeId, trainingSessionId])
  @@index([groupId])
}

model Emargement {
  id             String      @id @default(cuid())
  status         String      @default("en_attente")
  validationCode String?
  codeSentAt     DateTime?
  validatedAt    DateTime?
  // "portail" | "pin" | "formateur" : preuve de l'origine de la signature
  signedVia      String?
  inscriptionId  String
  slotId         String
  inscription    Inscription @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  slot           Slot        @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([inscriptionId, slotId])
}

model SessionDocument {
  id                String          @id @default(cuid())
  trainingSessionId String
  title             String
  // Clé R2 privée, servie par URL présignée courte
  fileKey           String
  mimeType          String
  size              Int
  // null = visible dès l'envoi des accès
  visibleFrom       DateTime?
  createdAt         DateTime        @default(now())
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)

  @@index([trainingSessionId])
}
