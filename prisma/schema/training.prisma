model Organisme {
  id              String  @id @default(uuid())
  name            String
  agreementNumber String? // n° d'agrément
  logo            String?
  inviteCode      String  @unique @default(cuid())
  siret           String?
  email           String?
  phone           String?
  website         String?
  address         String?
  postalCode      String?
  city            String?

  // Paramètres de rétention
  retentionYearsActive  Int @default(5)  // Données actives (compte, dossiers)
  retentionYearsArchive Int @default(10) // Preuves de diplômes (archive légale)

  // Configuration SMTP
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String? // Chiffré via Prisma extension
  smtpFrom     String?
  smtpSecure   Boolean @default(true)

  users            User[]
  trainingSessions TrainingSession[]
  trainees         Trainee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingSession {
  id          String    @id @default(uuid())
  type        String // PSC | PSE1 | PSE2 | SST | IPS | FF | FPS
  title       String
  location    String
  status      String    @default("planifiée") // planifiée | en_cours | terminée | annulée
  isFC        Boolean   @default(false)
  maxTrainees Int
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date

  formateurId String
  formateur   User   @relation(fields: [formateurId], references: [id])

  organismeId String
  organisme   Organisme @relation(fields: [organismeId], references: [id])

  slots        Slot[]
  inscriptions Inscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Slot {
  id        String   @id @default(cuid())
  label     String // ex: "Jour 1 - Matin"
  date      DateTime @db.Date
  startTime String // ex: "09:00"
  endTime   String // ex: "12:30"

  trainingSessionId String
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)

  emargements Emargement[]
}

model Trainee {
  id          String    @id @default(cuid())
  civility    String?
  firstName   String?   // Rendu optionnel pour anonymisation
  lastName    String?   // Rendu optionnel pour anonymisation
  email       String?
  emailHash   String?
  phone       String?
  dateOfBirth String?
  birthPlace  String?
  address     String?

  // Champs de suivi et statistiques pour la rétention
  isAnonymized   Boolean  @default(false)
  lastActivityAt DateTime @default(now())
  ageAtFormation Int?     // Conservé après anonymisation pour stats
  department     String?  // Conservé après anonymisation pour stats

  organismeId String
  organisme   Organisme @relation(fields: [organismeId], references: [id], onDelete: Cascade)

  inscriptions      Inscription[]
  externalTrainings ExternalTraining[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([emailHash, organismeId])
}

model ExternalTraining {
  id                String   @id @default(cuid())
  traineeId         String
  organismeId       String
  type              String
  name              String
  organisme         String
  obtainedAt        DateTime @db.Date
  isFC              Boolean  @default(false)
  certificateNumber String?
  fileUrl           String?
  fileKey           String?

  trainee Trainee @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inscription {
  id     String @id @default(cuid())
  status String @default("inscrit") // inscrit | présent | absent | éliminé
  attestationResult      String?   // "acquis" | "non_acquis"
  attestationValidatedAt DateTime?

  traineeId String
  trainee   Trainee @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  trainingSessionId String
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)

  emargements Emargement[]

  @@unique([traineeId, trainingSessionId])
}

model Emargement {
  id             String    @id @default(cuid())
  status         String    @default("en_attente") // en_attente | validé | absent
  validationCode String? // 6 chiffres
  codeSentAt     DateTime?
  validatedAt    DateTime?

  inscriptionId String
  inscription   Inscription @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)

  slotId String
  slot   Slot   @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([inscriptionId, slotId])
}
