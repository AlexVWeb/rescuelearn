model Organisme {
  id                    String            @id @default(uuid())
  name                  String
  agreementNumber       String?
  logo                  String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  inviteCode            String            @unique @default(cuid())
  address               String?
  city                  String?
  email                 String?
  phone                 String?
  postalCode            String?
  siret                 String?
  website               String?
  retentionYearsActive  Int               @default(5)
  retentionYearsArchive Int               @default(10)
  smtpFrom              String?
  smtpHost              String?
  smtpPassword          String?
  smtpPort              Int?
  smtpSecure            Boolean           @default(true)
  smtpUser              String?
  federation            Federation?
  federationName        String?
  documentHeader        String?
  isQualiopi            Boolean           @default(false)
  legalRepFirstName     String?
  legalRepJobTitle      String?
  legalRepLastName      String?
  legalStatus           String?
  qualiopiCertifiedBy   String?
  tvaNumber             String?
  metadata              String?
  slug                  String            @unique
  // CGV courantes (PDF R2 privé) ; version = SHA-256 du PDF
  termsFileKey          String?
  termsVersion          String?
  termsUpdatedAt        DateTime?
  invitations           Invitation[]
  members               Member[]
  modules               OrganismeModule[]
  trainees              Trainee[]
  trainingSessions      TrainingSession[]
  users                 User[]
  welcomeKits           WelcomeKit[]
}

// Modèle d'accueil par type de formation, résolu à la volée par les sessions
model WelcomeKit {
  id          String               @id @default(cuid())
  organismeId String
  type        String
  // Une ligne = une puce
  toBring     String?
  // [{ id, label }] : ids stables, les coches des stagiaires y sont rattachées
  checklist   Json                 @default("[]")
  updatedAt   DateTime             @updatedAt
  documents   WelcomeKitDocument[]
  organisme   Organisme            @relation(fields: [organismeId], references: [id], onDelete: Cascade)

  @@unique([organismeId, type])
}

model WelcomeKitDocument {
  id                String     @id @default(cuid())
  welcomeKitId      String
  title             String
  fileKey           String
  mimeType          String
  size              Int
  // null = visible dès l'envoi des accès ; N = minuit (Paris) de startDate - N jours
  visibleDaysBefore Int?
  createdAt         DateTime   @default(now())
  welcomeKit        WelcomeKit @relation(fields: [welcomeKitId], references: [id], onDelete: Cascade)

  @@index([welcomeKitId])
}

/// Module fonctionnel d'un organisme. Absence de ligne = défauts du registre
/// (src/lib/organisme-modules/registry.ts). Actif = available && enabled.
model OrganismeModule {
  organismeId String
  module      String
  /// Décidé par le super admin
  available   Boolean   @default(true)
  /// Décidé par l'admin de l'organisme
  enabled     Boolean   @default(false)
  updatedAt   DateTime  @updatedAt
  organisme   Organisme @relation(fields: [organismeId], references: [id], onDelete: Cascade)

  @@id([organismeId, module])
}

/// Fédération de rattachement : détermine les modèles de documents disponibles
enum Federation {
  CROIX_ROUGE
  FNPC
  CROIX_BLANCHE
  ORDRE_DE_MALTE
  FFSS
  FNSPF
  ANPS
  UNASS
  SNSM
  AUTRE
}

model TrainingSession {
  id                       String                     @id @default(uuid())
  type                     String
  title                    String
  location                 String
  status                   String                     @default("planifiée")
  maxTrainees              Int
  formateurId              String
  // Responsable pédagogique (FISE PSE) : membre de l'organisme, formateur ou non
  responsablePedagogiqueId String?
  organismeId              String
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  endDate                  DateTime?                  @db.Date
  isFC                     Boolean                    @default(false)
  startDate                DateTime?                  @db.Date
  inscriptions             Inscription[]
  slots                    Slot[]
  formateur                User                       @relation("SessionOwner", fields: [formateurId], references: [id])
  responsablePedagogique   User?                      @relation("SessionResponsablePedagogique", fields: [responsablePedagogiqueId], references: [id], onDelete: SetNull)
  organisme                Organisme                  @relation(fields: [organismeId], references: [id])
  quizSessions             QuizSession[]
  formateurs               TrainingSessionFormateur[]
  groups                   TrainingGroup[]
  // Publication explicite des attestations dans l'espace stagiaire
  attestationsPublishedAt  DateTime?
  documents                SessionDocument[]
  attestationSignatures    AttestationSignature[]
  // Kit d'accueil : propre au lieu / à la session
  accessInfo               String?
  toBringExtra             String?

  @@index([responsablePedagogiqueId])
}

model TrainingSessionFormateur {
  id                String          @id @default(cuid())
  trainingSessionId String
  userId            String
  createdAt         DateTime        @default(now())
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingSessionId, userId])
  @@index([userId])
}

model TrainingGroup {
  id                String          @id @default(cuid())
  trainingSessionId String
  name              String
  position          Int
  formateurId       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  formateur         User?           @relation(fields: [formateurId], references: [id], onDelete: SetNull)
  inscriptions      Inscription[]

  @@index([trainingSessionId])
  @@index([formateurId])
}

model Slot {
  id                String          @id @default(cuid())
  label             String
  date              DateTime        @db.Date
  startTime         String
  endTime           String
  trainingSessionId String
  emargements       Emargement[]
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
}

model Trainee {
  id                 String             @id @default(cuid())
  firstName          String?
  lastName           String?
  email              String?
  phone              String?
  dateOfBirth        String?
  organismeId        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  address            String?
  civility           String?
  birthPlace         String?
  emailHash          String?
  ageAtFormation     Int?
  department         String?
  isAnonymized       Boolean            @default(false)
  lastActivityAt     DateTime           @default(now())
  externalTrainings  ExternalTraining[]
  inscriptions       Inscription[]
  organisme          Organisme          @relation(fields: [organismeId], references: [id], onDelete: Cascade)
  quizParticipations QuizParticipant[]

  @@unique([emailHash, organismeId])
}

model ExternalTraining {
  id                String   @id @default(cuid())
  traineeId         String
  organismeId       String
  type              String
  name              String
  organisme         String
  obtainedAt        DateTime @db.Date
  isFC              Boolean  @default(false)
  certificateNumber String?
  fileUrl           String?
  fileKey           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  trainee           Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)
}

model Inscription {
  id                        String               @id @default(cuid())
  status                    String               @default("inscrit")
  traineeId                 String
  trainingSessionId         String
  attestationResult         String?
  attestationValidatedAt    DateTime?
  emargements               Emargement[]
  trainee                   Trainee              @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  trainingSession           TrainingSession      @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  groupId                   String?
  group                     TrainingGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Espace stagiaire : SHA-256 du token du lien, jamais le token en clair
  accessTokenHash           String?              @unique
  accessSentAt              DateTime?
  accessLastUsedAt          DateTime?
  // Verrou anti-devinette du PIN depuis l'espace stagiaire
  pinFailedCount            Int                  @default(0)
  pinLockedUntil            DateTime?
  signedAttestations        SignedAttestation[]
  // Le stagiaire peut couper les rappels, pas l'accès aux évaluations
  evaluationRemindersOptOut Boolean              @default(false)
  evaluationResponses       EvaluationResponse[]
  evaluationReminders       EvaluationReminder[]
  // { [itemId]: ISO date } ; coches orphelines ignorées
  checklistDone             Json?
  // Preuve d'acceptation des CGV : version et PDF exacts, figés
  termsAcceptedAt           DateTime?
  termsVersion              String?
  termsFileKey              String?
  termsAcceptedIp           String?
  termsAcceptedUa           String?
  // { [documentId]: ISO date } au premier téléchargement d'une pré-lecture
  prereadOpenedAt           Json?

  @@unique([traineeId, trainingSessionId])
  @@index([groupId])
}

model Emargement {
  id             String      @id @default(cuid())
  status         String      @default("en_attente")
  validationCode String?
  codeSentAt     DateTime?
  validatedAt    DateTime?
  // "portail" | "pin" | "formateur" : preuve de l'origine de la signature
  signedVia      String?
  inscriptionId  String
  slotId         String
  inscription    Inscription @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  slot           Slot        @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([inscriptionId, slotId])
}

model SessionDocument {
  id                String          @id @default(cuid())
  trainingSessionId String
  title             String
  // Clé R2 privée, servie par URL présignée courte
  fileKey           String
  mimeType          String
  size              Int
  // null = visible dès l'envoi des accès
  visibleFrom       DateTime?
  // "preparation" (à lire avant) | "support"
  kind              String          @default("support")
  createdAt         DateTime        @default(now())
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)

  @@index([trainingSessionId])
}

model AttestationSignature {
  id                String              @id @default(cuid())
  trainingSessionId String
  signerId          String
  // Figé au moment de signer : un renommage ultérieur ne change pas l'attestation
  signerName        String
  signedAt          DateTime            @default(now())
  ipAddress         String?
  userAgent         String?
  // PNG du tracé sur R2, chiffré
  signatureImageKey String
  // Dépublication : la ligne reste comme trace
  revokedAt         DateTime?
  revokedById       String?
  trainingSession   TrainingSession     @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  signer            User                @relation("AttestationSigner", fields: [signerId], references: [id])
  revokedBy         User?               @relation("AttestationRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  attestations      SignedAttestation[]

  @@index([trainingSessionId])
}

model SignedAttestation {
  id            String               @id @default(cuid())
  signatureId   String
  inscriptionId String
  // PDF sur R2, chiffré
  fileKey       String
  // SHA-256 du PDF en clair, tel que téléchargé par le stagiaire
  sha256        String
  size          Int
  signature     AttestationSignature @relation(fields: [signatureId], references: [id], onDelete: Cascade)
  inscription   Inscription          @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)

  @@unique([signatureId, inscriptionId])
  @@index([inscriptionId])
}

// Évaluations à chaud (J+0 → J+30) et à froid (J+90 → J+120) : fenêtres
// calculées depuis la fin du dernier créneau, questionnaires définis en code
model EvaluationResponse {
  id            String      @id @default(cuid())
  inscriptionId String
  // "chaud" | "froid"
  type          String
  // Version du questionnaire, figée à la première sauvegarde
  version       String
  answers       Json
  // "brouillon" | "soumise"
  status        String      @default("brouillon")
  submittedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  inscription   Inscription @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)

  @@unique([inscriptionId, type])
}

// Un envoi par palier ("chaud-j0", "chaud-j7"…) : le cron reste idempotent
model EvaluationReminder {
  id            String      @id @default(cuid())
  inscriptionId String
  kind          String
  sentAt        DateTime    @default(now())
  inscription   Inscription @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)

  @@unique([inscriptionId, kind])
}
