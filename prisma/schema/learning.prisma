model LearningCard {
  id            Int          @id @default(autoincrement())
  theme         String
  niveau        String
  info          String
  reference     String
  referencielId Int?
  referenciel   Referenciel? @relation(fields: [referencielId], references: [id])
}

model Referenciel {
  id            Int            @id @default(autoincrement())
  title         String
  pdfUrl        String
  yearEdition   Int
  learningCards LearningCard[]
  quizzes       Quiz[]
}
