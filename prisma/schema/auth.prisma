model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  roles         Json      @default("[]")
  password      String?
  
  firstName     String?
  lastName      String?
  phone         String?
  
  organismeId   String?
  organisme     Organisme? @relation(fields: [organismeId], references: [id])
  
  sessions      Session[]
  accounts      Account[]
  
  trainingSessions TrainingSession[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope        String?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Invitation {
  id          String   @id @default(cuid())
  email       String
  role        String
  organismeId String
  organisme   Organisme @relation(fields: [organismeId], references: [id])
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([email, organismeId])
  @@index([token])
}
